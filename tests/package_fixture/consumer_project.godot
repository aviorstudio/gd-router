; Consumer-owned autoload lifecycle fixture.
config_version=5

[application]

config/name="gd-router consumer ownership"
config/features=PackedStringArray("4.7")

[autoload]

GdRouter="*res://consumer_router.gd"
ConsumerOwned="*res://consumer_router.gd"

[consumer]

sentinel="preserve consumer configuration"

[editor_plugins]

enabled=PackedStringArray()
